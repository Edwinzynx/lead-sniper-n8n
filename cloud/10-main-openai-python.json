      "typeVersion": 1.1,
      "position": [
        1640,
        200
      ],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": {
          "__rl": true,
          "value": "lead_sniper_control",
          "mode": "name"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "id",
              "condition": "eq",
              "keyValue": "={{ $json.row.id }}"
            },
            {
              "keyName": "version",
              "condition": "eq",
              "keyValue": "={{ $json.row.version }}"
            },
            {
              "keyName": "lease_until",
              "condition": "lte",
              "keyValue": "={{ new Date().toISOString() }}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1,
        "options": {},
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "version": "={{ $json.row.version + 1 }}",
            "owner": "={{ $json.owner }}",
            "lease_until": "={{ new Date(Date.now()+600000).toISOString() }}"
          },
          "matchingColumns": [],
          "schema": [
            {
              "id": "version",
              "displayName": "version",
              "type": "number",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "removed": false
            },
            {
              "id": "owner",
              "displayName": "owner",
              "type": "string",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "removed": false
            },
            {
              "id": "lease_until",
              "displayName": "lease_until",
              "type": "date",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        }
      },
      "alwaysOutputData": false
    },
    {
      "id": "8be06529a73090b8ec8c8dcb36fa7420",
      "name": "Cycle Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        440
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const control=$input.first().json;const p=$('Prepare Lease').first().json;if(control.owner!==p.owner)throw new Error('Lease not acquired');return [{json:{state:{control,owner:p.owner,deadline:p.deadline,config:JSON.parse(control.data)}}}];"
      }
    },
    {
      "id": "eaa50ee8778ee06c18b718b837b3f526",
